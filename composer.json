{\n    "name": "laravel/crm",\n    "description": "A Laravel CRM project",\n    "type": "project",\n    "require": {\n        "php": "^8.0",\n        "laravel/framework": "^11.0",\n        "laravel/tinker": "^2.0"\n    },\n    "require-dev": {\n        "facade/ignition": "^2.5",\n        "phpunit/phpunit": "^10.0"\n    },\n    "autoload": {\n        "psr-4": {\n            "App\\": "app/"\n        }\n    },\n    "scripts": {\n        "post-autoload-dump": [\n            "Illuminate\Foundation\ComposerScripts::postAutoloadDump",\n            "php artisan package:discover --ansi"\n        ],\n        "post-update-cmd": [\n            "php artisan vendor:publish --all --force"\n        ]\n    }\n}